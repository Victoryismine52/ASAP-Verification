# Eligibility Service – environment variables
# Copy this file to .env and fill in the values.

# Which adapter to use: "mock" (default) or "availity"
ELIGIBILITY_PROVIDER=mock

# Availity credentials (only required when ELIGIBILITY_PROVIDER=availity)
AVAILITY_CLIENT_ID=
AVAILITY_CLIENT_SECRET=
AVAILITY_BASE_URL=https://api.availity.com
